{
  "schemaVersion": 1,
  "id": "create",
  "version": "${version}",
  "name": "Create",
  "description": "Technology that empowers the player. (Unofficial Fabric port)",
  "authors": [],
  "contact": {},
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "client": [
      "com.simibubi.create.CreateClient"
    ],
    "main": [
      "com.simibubi.create.Create"
    ]
  },
  "accessWidener": "create.accesswidener",
  "mixins": [
    "create.mixins.json"
  ],
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/class_1297": ["com/simibubi/create/foundation/mixin/extension/EntityExtension"],
      "net/minecraft/class_2586": ["com/simibubi/create/foundation/mixin/extension/BlockEntityExtension"],
      "net/minecraft/class_465": ["com/simibubi/create/foundation/mixin/extension/AbstractContainerScreenExtension"],
      "net/minecraft/class_1799": ["com/simibubi/create/foundation/mixin/extension/ItemStackExtension"],
      "net/minecraft/class_304": ["com/simibubi/create/foundation/mixin/extension/KeyMappingExtension"],
      "net/minecraft/class_1792": ["com/simibubi/create/foundation/mixin/extension/ItemExtension"],
      "net/minecraft/class_2248": ["com/simibubi/create/foundation/mixin/extension/BlockExtension"],
      "net/minecraft/class_1920": ["com/simibubi/create/foundation/mixin/extension/BlockAndTintGetterExtension"],
      "net/minecraft/class_1087": ["com/simibubi/create/foundation/mixin/extension/BakedModelExtension"],
      "net/minecraft/class_3611": ["com/simibubi/create/foundation/mixin/extension/FluidExtension"],
      "net/minecraft/class_3610": ["com/simibubi/create/foundation/mixin/extension/FluidStateExtension"]
    }
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
